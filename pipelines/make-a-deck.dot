// make-a-deck.dot -- amplifier-stories narrative-deck pipeline (PHASE 3: gated
// + TWO isolated fact-check gates).
//
// Turns a topic (graph goal) into a self-contained narrative HTML deck that
// passes tools/narrative_lint.py, guarded by an automated STRUCTURAL gate, a
// bounded render loop-back, AND two INDEPENDENT, FULLY-ISOLATED fact-check gates
// that stop us building a narrative on a hallucinated fact (research gate) or
// shipping a deck whose claims aren't supported (deck gate):
//
//   start -> reset -> research -> research_factcheck -> rfc_gate -> spine
//         -> render -> lint -> deck_factcheck -> dfc_gate -> done
//     rfc_gate --pass----> spine     (every material research claim supported)
//     rfc_gate --fail----> research  (re-gather; fix flagged claims, <=2x)
//     rfc_gate --flagged-> flagged   (research gate retries exhausted)
//     lint     --pass----> deck_factcheck   (deck is linter-clean)
//     lint     --retry---> render           (HARD-FAIL, retries remain, <=3x)
//     lint     --flagged-> flagged           (lint retries exhausted)
//     dfc_gate --pass----> done      (every deck claim supported)
//     dfc_gate --fail----> render    (drop/fix unsupported claims, <=2x)
//     dfc_gate --flagged-> flagged   (deck gate retries exhausted)
//     flagged  -> done
//
// ISOLATION (user-mandated): each *_factcheck node runs with fidelity=truncate
// -> a FRESH session whose preamble is ONLY the graph goal + run id (see
// fidelity.py _build_truncate_preamble). It therefore has NO conversational
// knowledge of how research/spine/render were produced. It re-derives every fact
// from ground truth and sees ONLY the specific artifact FILE we tell it to read.
//
// WHY FILES (not $tokens / report_outcome): in this backend, LLM (box) nodes
// return PROSE -- their report_outcome/context_updates are NOT captured (verified
// in phase 2: research/spine/render all logged as "Plain text response",
// context_updates=None), and $token prompt-expansion only resolves keys a TOOL
// node put into context. So an LLM node can neither hand a big artifact to a
// downstream node via context NOR carry a routing verdict. We therefore hand
// artifacts between nodes as FILES at fixed absolute paths, and split each
// fact-check gate -- exactly like the existing render->lint(gate) pair -- into:
//   * an ISOLATED LLM checker (fidelity=truncate) that READS the artifact file,
//     re-derives the facts, WRITES its findings + a one-word verdict file, and
//   * a tiny TOOL router (parallelogram, parse_json) that reads the verdict file,
//     applies the bounded-retry counter (pipelines/factcheck_gate.sh), and emits
//     the routing key into context deterministically.
//
// Artifact files (all under ai_working/pipeline-test/, cleared each run by reset):
//   research.json           research writes it; research_factcheck reads it
//   research_verified.json  research_factcheck writes it; spine+render+deck gate read it
//   research_flags.txt      research_factcheck writes it; rfc_gate -> $research_flags
//   .rfc_verdict            research_factcheck writes pass|fail; rfc_gate reads it
//   spine.json              spine writes it; render reads it
//   deck.html               render writes it; lint + deck_factcheck read it
//   deck_flags.txt          deck_factcheck writes it; dfc_gate -> $deck_flags
//   .dfc_verdict            deck_factcheck writes pass|fail; dfc_gate reads it
//
// ROUTING KEYS (no collision): lint uses `route`; the fact-check gates use their
// OWN keys `rfc_route` and `dfc_route` (emitted by their TOOL routers). $tokens
// that DO expand are those a tool node populates: $lint_feedback (lint),
// $research_flags (rfc_gate / reset seed), $deck_flags (dfc_gate / reset seed).
//
// Bounds: lint = 3 loop-backs; each fact-check gate = 2 loop-backs. Past its
// bound a gate emits *_route=flagged -> `flagged` node -> done (outcome FAIL)
// instead of spinning; the engine max_steps guard is the backstop.
//
// $goal expands from graph[goal=...] (or the CLI message). Output/artifact paths
// are baked as literal absolute paths in the prompts.

digraph MakeADeck {
    graph [
        goal="The Foundry and the Machine: how a small tool in the Amplifier project builds a machine that writes software the model never directly writes -- what the foundry is, how it works, and why it matters. Ground every claim in the Amplifier repos under /home/ramparte/dev/ANext.",
        label="amplifier-stories: make-a-deck (phase 3: narrative_lint gate + isolated research/deck fact-check gates)",
        output_path="/home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/deck.html",
        default_fidelity="full",
        default_thread_id="make-a-deck",
        default_max_retry=1
    ]
    rankdir=LR

    // -- Structural nodes ---------------------------------------------------
    start [shape=Mdiamond, label="Start"]
    done  [shape=Msquare,  label="Done"]

    // -- Stage 0: reset (once-per-run gate state) ---------------------------
    // Clears the lint retry counter AND both fact-check counters/verdict/artifact
    // files, and seeds neutral $lint_feedback / $research_flags / $deck_flags so
    // the first research/render see empty feedback. Runs exactly once (NOT on any
    // loop), so no counter or stale artifact can leak between runs.
    reset [
        shape=parallelogram,
        label="Reset gate",
        tool_command="bash /home/ramparte/dev/ANext/amplifier-stories/pipelines/lint_gate.sh reset",
        parse_json="true"
    ]

    // -- Stage 1: research (verified facts only) ----------------------------
    research [
        label="Research",
        prompt="Gather VERIFIED facts about the topic: $goal.\n\nRETRY NOTE: if an independent fact-checker previously rejected some of your claims, they are listed here (empty / neutral on the first pass):\n  $research_flags\nIf that lists real problems, RE-GATHER and fix EXACTLY those claims with fresh evidence; do not restate a claim you cannot support.\n\nFIRST identify the primary sources for THIS topic yourself -- do NOT assume it is about any particular tool or file; the goal above decides the subject. Search the repos under /home/ramparte/dev/ANext with bash to find the code, commits, docs, and features the topic refers to: run `git log`, `git show`, `gh`, `grep`/`rg`, `wc -l`, `ls`, and read the relevant files in full. Prefer microsoft/* and ramparte/* repos; never the anthropics/* forks.\n\nHARD RULE: EVERY metric / date / name / claim MUST trace to actual command output you ran -- never fabricate. If you cannot verify something, do NOT state it as fact; list it under unverified_notes instead.\n\nWhen finished, WRITE (with the write_file tool) a compact JSON object to this EXACT absolute path:\n  /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/research.json\nThe JSON encodes this object: {title, topic, verified_metrics:[{claim, value, source_command, evidence}], timeline, contributors, feature_status, core_story, unverified_notes}. Every field must be grounded in a command you actually ran. After writing, state the path you wrote."
    ]

    // -- Stage 1b: research_factcheck (ISOLATED independent verification) ----
    // Fresh session (fidelity=truncate): preamble is ONLY goal + run-id, so it has
    // NO memory of how `research` gathered anything. It reads the research.json
    // artifact FILE, re-derives every fact from ground truth, and writes back:
    // research_verified.json (cleaned facts spine/render build on), research_flags
    // .txt (what it rejected + evidence), and a one-word .rfc_verdict that the
    // rfc_gate TOOL router turns into the bounded rfc_route.
    research_factcheck [
        shape=box,
        fidelity="truncate",
        label="Research fact-check (isolated)",
        prompt="You are an INDEPENDENT fact-checker running in a FRESH, ISOLATED session. You have NO prior context and NO knowledge of who produced the file below or how -- do not assume any. Read this ONE file, which CLAIMS facts about a topic:\n  /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/research.json\n\nFor EACH claim / metric / date / name / attribution in it, INDEPENDENTLY verify it against ground truth: run git log, gh, grep/rg, wc -l, and read files in the relevant repos under /home/ramparte/dev/ANext (prefer microsoft/* and ramparte/* repos; never the anthropics/* forks). Do NOT trust the file -- re-derive every fact from actual command output. A claim is SUPPORTED only if a command you actually ran produces the evidence; otherwise it is UNSUPPORTED or CONTRADICTED.\n\nThen write THREE files with the write_file tool (ALL of them):\n1. /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/research_flags.txt -- a human-readable list of every UNSUPPORTED or CONTRADICTED claim, each with the evidence you found or the command that failed to support it. If every material claim checks out, write exactly the text: (none)\n2. /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/research_verified.json -- the input JSON with every unverifiable claim REMOVED or CORRECTED to match your evidence, so downstream nodes build only on vetted facts. Write this on EVERY verdict (on a pass it is simply the vetted artifact).\n3. /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/.rfc_verdict -- containing EXACTLY one word and nothing else: pass if EVERY material claim is supported by evidence you gathered, otherwise fail.\n\nWrite all three files. A deterministic gate reads .rfc_verdict to route the pipeline; if you write nothing it fail-safes to fail."
    ]

    // -- Stage 1c: rfc_gate (deterministic router for the research gate) -----
    // Reads .rfc_verdict + the bounded counter, emits rfc_route in {pass|fail|
    // flagged} and carries $research_flags forward for the re-gather loop.
    rfc_gate [
        shape=parallelogram,
        label="Research fact-check gate",
        tool_command="bash /home/ramparte/dev/ANext/amplifier-stories/pipelines/factcheck_gate.sh rfc",
        parse_json="true"
    ]

    // -- Stage 2: spine (narrative contract v2) -----------------------------
    spine [
        label="Spine",
        prompt="Read the INDEPENDENTLY-VERIFIED research JSON at:\n  /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/research_verified.json\nAn upstream isolated fact-checker already removed/corrected any unsupported claims -- use ONLY this file and do NOT reintroduce facts it dropped, even if you recall them. Then write a narrative spine that follows the v2 contract in /home/ramparte/dev/ANext/amplifier-stories/context/storyteller-instructions.md -- READ that file first, especially the '## Narrative Layer' section.\n\nProduce: (1) a TITLE for the cover slide -- a punchy deck name of FIVE WORDS OR FEWER -- plus an optional one-line SUBTITLE (a short descriptor phrase, not a sentence); (2) a one-line ABT in And / But / Therefore form; (3) a named Payoff (the climax the deck drives toward); (4) an ordered list of 6-8 beats. Each beat has a role from: frame | proof | setup | tension | mechanism | turn | payoff | takeaway, a one-line CLAIM, and an `advances` note saying how it serves the ABT.\n\nHARD RULES: beat 1 role MUST be `frame` (an orientation hook -- what this is / the problem it solves / why it matters -- not a bland title card). A `proof` beat MUST land within the first THREE beats. Every beat MUST have an `advances` note. A `payoff` beat MUST be present, landing in the back half as the climax. Mechanism beats make ONE claim each (no catalog beats).\n\nWhen finished, WRITE (with the write_file tool) a compact JSON object to this EXACT absolute path:\n  /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/spine.json\nencoding: {title, subtitle, abt:{and,but,therefore}, payoff, beats:[{n, role, claim, advances}]}. The title MUST be 5 words or fewer; subtitle may be an empty string if there is none. After writing, state the path you wrote."
    ]

    // -- Stage 3: render (self-contained HTML deck, linter-clean) -----------
    render [
        label="Render",
        prompt="You are the deck RENDERER. Read these TWO input files with your read tool BEFORE writing anything -- they are the ONLY source of facts (add nothing else):\n  - verified research: /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/research_verified.json\n  - narrative spine:   /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/spine.json\n\nRETRY-AWARE GATE FEEDBACK: after this deck is written it is checked by (1) a deterministic structural linter (tools/narrative_lint.py) and (2) an INDEPENDENT deck fact-checker. If a PRIOR attempt failed, the specific problems are here (empty / neutral on the first pass):\n  - failing lint checks:      $lint_feedback\n  - unsupported deck claims:   $deck_flags\nIf either lists real problems you are REWRITING an existing deck: fix EXACTLY those and let nothing else regress. Lint culprits map 1:1 to the checks -- a `<!-- beat N: role -->` comment without a matching `<div class=\"slide\">` (beat/slide parity), a missing `frame` first beat, no `proof` beat within the first THREE beats, a missing `payoff` beat, an incomplete spine comment (must contain `ABT:`, `Payoff:`, and an `advances:` note per beat), or a missing Sources & Methodology slide. Deck-fact-check culprits are claims on slides not supported by research_verified.json -- REMOVE or CORRECT them (watch the frame slide for embellished framing).\n\nBuild ONE self-contained HTML deck following /home/ramparte/dev/ANext/amplifier-stories/context/storyteller-instructions.md EXACTLY: the Narrative Layer, the HTML template, the progressive-enhancement rules, and the Sources & Methodology slide. Write the finished file with write_file to this EXACT absolute path (create nothing under docs/):\n  /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/deck.html\n\nSTRUCTURAL REQUIREMENTS -- narrative_lint.py checks these; follow them precisely or it HARD-FAILS:\n1. SPINE COMMENT: the FIRST thing inside <body> is a single HTML comment carrying the spine. It MUST literally contain the tokens `ABT:` (with the And/But/Therefore sentence), `Payoff:` (the named payoff), and an `advances:` note for EVERY beat.\n2. TITLE COVER SLIDE: the FIRST slide is a near-wordless cover BEFORE beat 1, written EXACTLY as `<div class=\"slide title-slide active\">` -- put the spine `title` (FIVE WORDS OR FEWER) in an <h1>, and if the spine `subtitle` is non-empty put it in a `<p class=\"subtitle\">`...</p> directly beneath. It carries NO `<!-- beat N: role -->` comment and is the ONLY slide with the `active` class.\n3. ONE SLIDE PER BEAT: render EXACTLY ONE `<div class=\"slide\">` per spine beat, in order, AFTER the title cover (NONE of these carry `active`). Each beat slide begins with an HTML comment `<!-- beat N: role -->` (N = beat number, role = that beat's role; beat 1 role = frame) and leads with an <h1> or <h2> that is a CLAIM headline (an assertion) -- NEVER a bare topic label like Overview / Metrics / Features / Architecture / Summary.\n4. SOURCES SLIDE: add exactly ONE final `<div class=\"slide\">` for Sources & Methodology (its heading text must contain `Sources` or `Research Methodology`; list the git/gh/grep commands from the research). The title cover and this Sources slide are the only two slides with NO beat comment. Therefore total `<div class=\"slide\">` count == number of beats + 2 (title cover + one per beat + Sources).\n5. PROGRESSIVE ENHANCEMENT: include `<script>document.documentElement.classList.add('js')</script>` in <head> BEFORE <style>; default `.slide{display:flex}`; a `html:not(.js) .slide{...visible...}` no-JS fallback; and `html.js .slide{display:none}` + `html.js .slide.active{display:flex}`.\n6. FIT-SAFE: add `html.js .slide{max-height:100dvh;overflow-y:auto;}` so slides cap to the viewport and scroll. Size big numbers with clamp(); NEVER a fixed font-size >= 72px outside clamp(). LAYOUT (16:9 fill, fit ONE viewport): each slide MUST fit within one viewport (100dvh) at 100% zoom WITHOUT scrolling. Do NOT stack a headline + paragraph + a wide stat/steps/rules/card block vertically -- that overflows while the right half sits empty. For ANY slide that has a supporting block (stat grid, numbered steps, rules list, cards), use the two-column split from storyteller-instructions.md: give the slide class `slide split`, put the narrative (section label, headline, body, handoff) in a `col-main` div on the LEFT and the supporting block in a `col-aside` div on the RIGHT (vertically centered). Keep the headline to <=2 lines and body to <=3 lines (trim, do not shrink). Use the CONSERVATIVE TYPE SCALE from storyteller-instructions.md and do NOT exceed it: h1 clamp(32px,7vw,76px); h2 clamp(22px,4vw,40px); p/li clamp(14px,1.9vw,19px); .title-slide h1 clamp(40px,10vw,104px). Text-only slides (no supporting block) may stay single-column with the `center` class so short content is vertically centered.\n7. Keep a `More Amplifier Stories` link: `<a href=\"index.html\" class=\"more-stories\">More Amplifier Stories</a>`.\n8. Include the standard slide navigation JS (keyboard + click + dots + touch/swipe) from the template so the deck actually works.\n\nEvery number/name on a slide must come from research_verified.json -- add NOTHING unverified (an isolated fact-checker re-checks every deck claim). After writing the file, state the absolute path you wrote."
    ]

    // -- Stage 4: lint (automated STRUCTURAL GATE) --------------------------
    // Runs tools/narrative_lint.py on the rendered deck via lint_gate.sh, which
    // ALWAYS exits 0 and emits one line of JSON (parse_json merges it into
    // context): route in {pass|retry|flagged}, lint_hard_fail, lint_attempt, and
    // lint_feedback (the failing HARD-check names+details fed back to render).
    // Route-key routing (not outcome=fail) so the feedback survives into context.
    lint [
        shape=parallelogram,
        label="Structural lint gate",
        tool_command="bash /home/ramparte/dev/ANext/amplifier-stories/pipelines/lint_gate.sh check",
        parse_json="true"
    ]

    // -- Stage 5: deck_factcheck (ISOLATED claim-support verification) -------
    // Runs AFTER lint passes, in a FRESH session (fidelity=truncate): preamble is
    // ONLY goal + run-id, so it has NO memory of how the deck was rendered. It
    // reads the finished deck.html + the vetted research_verified.json FILES and
    // confirms EVERY deck claim -- including the frame-slide framing -- traces to
    // the verified research (catching render-time drift/embellishment). It writes
    // deck_flags.txt + a one-word .dfc_verdict for the dfc_gate router.
    deck_factcheck [
        shape=box,
        fidelity="truncate",
        label="Deck fact-check (isolated)",
        prompt="You are an INDEPENDENT fact-checker running in a FRESH, ISOLATED session. You have NO prior context and NO knowledge of how the deck below was written or by whom -- do not assume any. Read these TWO files with your read tool:\n  - the finished HTML deck: /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/deck.html\n  - the verified research:  /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/research_verified.json\n\nFor EVERY factual claim in the deck -- numbers, dates, repo names, attributions, impact/adoption claims, AND the framing/frame-slide assertions (the orientation hook, the problem statement, the 'why it matters') -- confirm it is SUPPORTED by research_verified.json. A deck claim is supported ONLY if the verified research contains matching evidence; a claim that is embellished, extrapolated, or simply absent from the verified research is UNSUPPORTED (this is exactly the render-time drift you exist to catch).\n\nThen write TWO files with the write_file tool (BOTH):\n1. /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/deck_flags.txt -- every UNSUPPORTED deck claim with its slide reference (the beat comment or heading) and why the verified research does not support it. If every deck claim is supported, write exactly the text: (none)\n2. /home/ramparte/dev/ANext/amplifier-stories/ai_working/pipeline-test/.dfc_verdict -- containing EXACTLY one word and nothing else: pass if EVERY deck claim is supported by the verified research, otherwise fail.\n\nWrite both files. A deterministic gate reads .dfc_verdict to route the pipeline; if you write nothing it fail-safes to fail."
    ]

    // -- Stage 5b: dfc_gate (deterministic router for the deck gate) --------
    // Reads .dfc_verdict + the bounded counter, emits dfc_route in {pass|fail|
    // flagged} and carries $deck_flags forward for the re-render loop.
    dfc_gate [
        shape=parallelogram,
        label="Deck fact-check gate",
        tool_command="bash /home/ramparte/dev/ANext/amplifier-stories/pipelines/factcheck_gate.sh dfc",
        parse_json="true"
    ]

    // -- Flagged terminal (any bounded retry exhausted, human review) -------
    // Reached when the deck still HARD-FAILs after the lint retries, OR when
    // either fact-check gate exhausts its retries. Exits non-zero on purpose so
    // the pipeline's final outcome is FAIL (the human-visible flag) with the
    // unresolved feedback -- rather than reporting success or spinning forever.
    flagged [
        shape=parallelogram,
        label="Flagged (unresolved)",
        tool_command="echo 'PIPELINE FLAGGED after bounded retries. Unresolved -- lint: $lint_feedback | research flags: $research_flags | deck flags: $deck_flags. Human review required.'; exit 1"
    ]

    // -- Flow: linear spine with three bounded gates ------------------------
    start -> reset -> research -> research_factcheck -> rfc_gate

    // Gate 1: isolated research fact-check (own key: rfc_route)
    rfc_gate -> spine    [label="pass",    condition="context.rfc_route=pass"]
    rfc_gate -> research [label="fail",    condition="context.rfc_route=fail"]
    rfc_gate -> flagged  [label="flagged", condition="context.rfc_route=flagged"]

    spine -> render -> lint

    // Structural lint gate (own key: route)
    lint -> deck_factcheck [label="pass",    condition="context.route=pass"]
    lint -> render         [label="retry",   condition="context.route=retry"]
    lint -> flagged        [label="flagged", condition="context.route=flagged"]

    deck_factcheck -> dfc_gate

    // Gate 2: isolated deck fact-check (own key: dfc_route)
    dfc_gate -> done    [label="pass",    condition="context.dfc_route=pass"]
    dfc_gate -> render  [label="fail",    condition="context.dfc_route=fail"]
    dfc_gate -> flagged [label="flagged", condition="context.dfc_route=flagged"]

    flagged -> done
}
